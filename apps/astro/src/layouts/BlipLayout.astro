---
import RadarIcon from "~assets/svg/radar.svg";
import ThemeSwitcher from "~components/themeSwitcher/ThemeSwitcher.astro";
import {
	themeHeadBootstrapScript,
	themeHeadCriticalStyles,
} from "~stores/theme-shared";
import { withBasePath } from "~utils/sitePaths";
import * as styles from "./Layout.css";

const faviconPath = withBasePath("/favicon.svg");
const homePath = withBasePath("/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tech Radar</title>
  	<style is:inline set:html={themeHeadCriticalStyles}></style>
  	<script is:inline set:html={themeHeadBootstrapScript}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Space+Grotesk:wght@300;400;500;700&display=optional" rel="stylesheet">
  </head>
  <body>
    <a class:list={[styles.radarIcon]} href={homePath}><RadarIcon  width={24} height={24} /></a>
    <div class={styles.topNavArea}>
			<ThemeSwitcher />
		</div>
    <main class={styles.mainContentBlip}>
      <slot name="center" />
    </main>
  </body>
</html>
