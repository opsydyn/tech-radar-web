---
export const prerender = true;
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, InferGetStaticParamsType } from "astro";
import BlipLayout from "~layouts/BlipLayout.astro";
import type { Blip } from "~types/radar-types";

import BlipHistory from "../../../../components/BlipHistory";
import DocumentFreshnessIndicator from "../../../../components/DocumentFreshnessIndicator.astro";
import RelatedBlipsSection from "../../../../components/RelatedBlipsSection.astro";
import MetaInfo from "../../../../components/page/MetaInfo.astro";
import PageHeader from "../../../../components/page/PageHeader.astro";
import StickyNavigation from "../../../../components/page/StickyNavigation.astro";
import { getBlipPath, getBlipSlug } from "../../../../utils/blipRouting";
import { formatDate } from "../../../../utils/dateFormatter";
import { buildRadarEditionViewsFromCollections } from "../../../../utils/editionSnapshotAdapter";
import { getQuadrantPath } from "../../../../utils/quadrantRouting";
import {
	getQuadrantColor,
	getQuadrantColorDark,
	getQuadrantColorSolid,
} from "../../../../utils/quadrantColors";
import { getRelatedBlipsContext } from "../../../../utils/relatedBlipsUtils";
import * as styles from "~styles/pages/blip.css";

type BlipCollectionEntry = CollectionEntry<"blip"> & { data: Blip };
type EditionSnapshotEntry = CollectionEntry<"editionSnapshot">;
type EditionBlipSnapshotEntry = CollectionEntry<"editionBlipSnapshot">;
type Params = InferGetStaticParamsType<typeof getStaticPaths>;

type BlipIdentity = Pick<Blip, "id" | "name">;

const matchesBlipRouteParam = (
	routeParam: string,
	blip: BlipIdentity,
): boolean => routeParam === blip.id || routeParam === getBlipSlug(blip);

export const getStaticPaths = (async () => {
	const blipEntries: BlipCollectionEntry[] = await getCollection("blip");
	const editionEntries: EditionSnapshotEntry[] =
		await getCollection("editionSnapshot");
	const snapshotEntries: EditionBlipSnapshotEntry[] = await getCollection(
		"editionBlipSnapshot",
	);
	const editionViews = buildRadarEditionViewsFromCollections({
		canonicalBlips: blipEntries.map(({ data }) => data),
		editionEntries,
		snapshotEntries,
	});

	return editionViews.flatMap(({ edition, blips }) =>
		blips.flatMap((blip) => {
			const slug = getBlipSlug(blip);
			const idPath =
				blip.id === slug
					? []
					: [{ params: { edition: edition.id, slug: blip.id } }];

			return [{ params: { edition: edition.id, slug } }, ...idPath];
		}),
	);
}) satisfies GetStaticPaths;

const canonicalBlips: BlipCollectionEntry[] = await getCollection("blip");
const editionEntries: EditionSnapshotEntry[] =
	await getCollection("editionSnapshot");
const editionBlipSnapshotEntries: EditionBlipSnapshotEntry[] =
	await getCollection("editionBlipSnapshot");
const { edition, slug } = Astro.params as Params;
const editionViews = buildRadarEditionViewsFromCollections({
	canonicalBlips: canonicalBlips.map(({ data }) => data),
	editionEntries,
	snapshotEntries: editionBlipSnapshotEntries,
});
const editionView =
	typeof edition === "string"
		? editionViews.find(
				({ edition: currentEdition }) => currentEdition.id === edition,
			)
		: undefined;
const editionEntry =
	typeof edition === "string"
		? editionEntries.find(({ data }) => data.id === edition)
		: undefined;
const canonicalBlip =
	typeof slug === "string"
		? canonicalBlips.find((entry) =>
				matchesBlipRouteParam(slug, {
					id: entry.data.id,
					name: entry.data.name,
				}),
			)
		: undefined;
const editionBlip =
	typeof slug === "string"
		? editionView?.blips.find((entry) =>
				matchesBlipRouteParam(slug, {
					id: entry.id,
					name: entry.name,
				}),
			)
		: undefined;
const blipData = editionBlip ?? canonicalBlip?.data;
const blipContent = canonicalBlip ? await render(canonicalBlip) : undefined;
const Content = blipContent?.Content;
const embeddedAdr = canonicalBlip?.data.adr;
const showAdrSection = canonicalBlip?.data.hasAdr === true;
const hasEmbeddedAdr = showAdrSection && embeddedAdr !== undefined;
const formattedDate = formatDate(canonicalBlip?.data.created);
const relatedBlipsContext =
	blipData?.id && typeof edition === "string"
		? await getRelatedBlipsContext(blipData.id, { editionId: edition })
		: null;
const enrichedRelatedBlips = relatedBlipsContext
	? [...relatedBlipsContext.relatedBlips]
	: [];
const currentEditionId =
	relatedBlipsContext?.type === "snapshot"
		? relatedBlipsContext.editionId
		: typeof edition === "string"
			? edition
			: undefined;
const fallbackRelatedBlips =
	enrichedRelatedBlips.length === 0
		? [...(relatedBlipsContext?.fallbackBlips ?? [])]
		: [];
const quadrantColorValue = getQuadrantColor(blipData?.quadrant);
const quadrantColorSolidValue = getQuadrantColorSolid(blipData?.quadrant);
const quadrantColorDarkValue = getQuadrantColorDark(blipData?.quadrant);
const editionSubtitle = editionEntry?.data.title ?? currentEditionId;
const quadrantBackLink =
	blipData?.quadrant && currentEditionId
		? getQuadrantPath(blipData.quadrant, { editionId: currentEditionId })
		: currentEditionId
			? `/?edition=${currentEditionId}`
			: "/";
const quadrantBackText = blipData?.quadrant ?? "Back to Radar";
---

<BlipLayout>
  <div slot="center" class={styles.container} style={`
    --quadrant-color: ${quadrantColorValue};
    --quadrant-color-solid: ${quadrantColorSolidValue};
    --quadrant-color-dark: ${quadrantColorDarkValue};
  `}>
    <PageHeader
      title={blipData?.name ?? "Tech Radar Blip"}
      subtitle={editionSubtitle ? `Edition snapshot: ${editionSubtitle}` : undefined}
    />

    <StickyNavigation
      backLink={quadrantBackLink}
      backText={quadrantBackText}
      tabs={[
        { href: "#overview", text: "Overview" },
        { href: "#adr", text: "ADR", condition: showAdrSection },
        { href: "#history", text: "History", condition: blipData?.move && blipData.move.length > 0 },
        { href: "#related", text: "Related" }
      ]}
      quadrantLinks={true}
      quadrantEditionId={currentEditionId}
    />

    <section id="overview" class={styles.detailsSection} slot="left">
      <MetaInfo
        date={formattedDate}
        status={blipData?.ring || ""}
        cursorColor={quadrantColorSolidValue}
      />

      <DocumentFreshnessIndicator
        dateValue={canonicalBlip?.data.created}
        showRecommendation={true}
        size="medium"
      />

      <div class={styles.detailsContent}>
        <p class={styles.detailsDescription}>
          {blipData?.description
            ? typeof blipData.description === "object"
              ? "Awaiting description"
              : blipData.description.trim()
            : "Awaiting description"
          }
        </p>
      </div>
    </section>

    {showAdrSection && (
      <section id="adr" class={styles.detailsSection} slot="left">
        <div class={hasEmbeddedAdr ? styles.adrSection : styles.adrSectionNoAdr}>
          <h2 class={styles.sectionTitle}>Architecture Decision Record</h2>
          {hasEmbeddedAdr && embeddedAdr ? (
            <div class={styles.detailsContent}>
              <div class={styles.adrMetaGrid}>
                <p class={styles.adrMetaItem}>
                  <span class={styles.adrMetaLabel}>Status:</span>{" "}
                  <span class={styles.adrStatusBadge}>{embeddedAdr.status}</span>
                </p>
                <p class={styles.adrMetaItem}>
                  <span class={styles.adrMetaLabel}>Author:</span> {embeddedAdr.author}
                </p>
                <p class={styles.adrMetaItem}>
                  <span class={styles.adrMetaLabel}>Reviewers:</span>{" "}
                  {embeddedAdr.reviewers.join(", ")}
                </p>
                <p class={styles.adrMetaItem}>
                  <span class={styles.adrMetaLabel}>Tags:</span>{" "}
                  {embeddedAdr.tags.join(", ")}
                </p>
              </div>

              {Content ? (
                <div class={styles.markdownContent}>
                  <Content />
                </div>
              ) : (
                <p class={styles.adrPending}>
                  Add <code>## Context</code>, <code>## Decision</code>, and <code>## Consequences</code> sections to this blip file.
                </p>
              )}
            </div>
          ) : (
            <p class={styles.adrPending}>
              Add an <code>adr</code> metadata block plus <code>## Context</code>, <code>## Decision</code>, and <code>## Consequences</code> sections to this blip.
            </p>
          )}
        </div>
      </section>
    )}

    {blipData?.move && blipData.move.length > 0 && (
      <section id="history" class={styles.detailsSection} slot="left">
        <h2 class={styles.sectionTitle}>Movement History</h2>
        <div class={styles.detailsContent}>
          <p class={styles.detailsDescription}>
            This visualization shows how this technology has moved through the radar over time.
          </p>
          <div class={styles.historyChart}>
            <BlipHistory width={700} height={300} moveHistory={blipData.move} client:load />
          </div>
        </div>
      </section>
    )}

    <section id="related" class={styles.fullBleed}>
      <div class={styles.relatedBlipsSection}>
        {enrichedRelatedBlips.length > 0 ? (
          <RelatedBlipsSection
            relatedBlips={enrichedRelatedBlips}
            currentBlipName={blipData?.name || ""}
            editionId={currentEditionId}
          />
        ) : (
          <>
            <h2 class={styles.relatedBlipsTitle}>Related Technologies</h2>
            <div class={styles.relatedBlipsGrid}>
              {fallbackRelatedBlips.map((blip) => (
                <a
                  href={getBlipPath(
                    blip,
                    currentEditionId ? { editionId: currentEditionId } : undefined,
                  )}
                  class={styles.relatedBlipCard}
                >
                  <span class={styles.relatedBlipMetaUnderlined}>{blip.ring}</span>
                  <div class={styles.relatedBlipTitleWrapper}>
                    <h3 class={styles.relatedBlipTitle}>{blip.name}</h3>
                  </div>
                  <p class={styles.relatedBlipMetaUnderlined}>{blip.quadrant}</p>
                </a>
              ))}

              {fallbackRelatedBlips.length === 0 && (
                <div class={styles.relatedBlipCard}>
                  <h3 class={styles.relatedBlipTitle}>No related technologies</h3>
                </div>
              )}
            </div>
          </>
        )}
      </div>
    </section>
  </div>
</BlipLayout>

