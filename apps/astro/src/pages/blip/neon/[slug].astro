---
import BlipLayout from "~layouts/BlipLayout.astro";
import { db } from "../../../db";
import { blips, blipAuthors, authors, moveHistory, blipTags, tags } from "../../../db/drizzle-schema";
import { eq, and, ne } from "drizzle-orm";
import { getQuadrantColor, getQuadrantColorSolid, getQuadrantColorDark } from "../../../utils/quadrantColors";
import * as styles from "../Blip.css";
import BlipHistory from "../../../components/BlipHistory";
import StatusDropdown from "../../../components/StatusDropdown";
import BlipDescriptionIsland from "@/components/BlipDescriptionIsland";


const { slug } = Astro.params;

if (!slug) {
  return new Response('Slug parameter is required', { status: 400 });
}

const fetchBlipData = async (blipSlug: string) => {
  const blipResult = await db.select().from(blips).where(eq(blips.slug, blipSlug));
  
  if (!blipResult || blipResult.length === 0) {
    throw new Error('Blip not found');
  }
  
  const blipData = blipResult[0];
  
  const authorResult = await db
    .select({
      name: authors.name,
      isPrimary: blipAuthors.isPrimary
    })
    .from(blipAuthors)
    .innerJoin(authors, eq(blipAuthors.authorId, authors.id))
    .where(eq(blipAuthors.blipId, blipData.id));
    
  const tagResult = await db
    .select({
      name: tags.name
    })
    .from(blipTags)
    .innerJoin(tags, eq(blipTags.tagId, tags.id))
    .where(eq(blipTags.blipId, blipData.id));
    
  const moveResult = await db
    .select()
    .from(moveHistory)
    .where(eq(moveHistory.blipId, blipData.id));
    
  const formattedDate = blipData.createdAt
    ? new Date(blipData.createdAt).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      })
    : 'No data recorded';
  
  const relatedBlips = await db.select()
    .from(blips)
    .where(and(
      eq(blips.quadrant, blipData.quadrant),
      ne(blips.id, blipData.id)
    ))
    .limit(3);
  
  const quadrantColorValue = getQuadrantColor(blipData.quadrant);
  const quadrantColorSolidValue = getQuadrantColorSolid(blipData.quadrant);
  const quadrantColorDarkValue = getQuadrantColorDark(blipData.quadrant);
  
  return {
    blipData,
    authorResult,
    tagResult,
    moveResult,
    relatedBlips,
    formattedDate,
    quadrantColorValue,
    quadrantColorSolidValue,
    quadrantColorDarkValue
  };
};

const getPageDataResult = await (async () => {
  try {
    const data = await fetchBlipData(slug);
    
    Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
    Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
    
    return { success: true, data };
  } catch (error: unknown) {
    console.error('Error fetching blip data:', error);
    if (error instanceof Error && error.message === 'Blip not found') {
      return { success: false, status: 404, message: 'Blip not found' };
    }
    return { 
      success: false, 
      status: 500, 
      message: `Error fetching blip data: ${error instanceof Error ? error.message : 'Unknown error'}` 
    };
  }
})();

if (!getPageDataResult.success) {
  return new Response(getPageDataResult.message, { status: getPageDataResult.status });
}

const {
  blipData,
  authorResult,
  tagResult,
  moveResult,
  relatedBlips,
  formattedDate,
  quadrantColorValue,
  quadrantColorSolidValue,
  quadrantColorDarkValue
} = getPageDataResult.data!;

---

<BlipLayout>
  <div 
    slot="center" 
    class={styles.container} 
    id="blip-container" 
    data-quadrant={blipData.quadrant}
    style={`
      --quadrant-color: ${quadrantColorValue};
      --quadrant-color-solid: ${quadrantColorSolidValue};
      --quadrant-color-dark: ${quadrantColorDarkValue};
    `}
  >
    <!-- Hero Section -->
    <section class={styles.heroSection}>
      <h1 class={styles.heroTitle}>{blipData.name}</h1>
    </section>

    <!-- Navigation Bar -->
    <div id="nav-sentinel"> </div>
    <div class={styles.navContainer}>
      <nav class={styles.navBar}>
        <a href="/" class={styles.navBack}>← Back to Radar</a>
        <div class={styles.navTabs}>
          <a href="#details" class={styles.navTab}>Details</a>
          {moveResult.length > 0 && <a href="#history" class={styles.navTab}>History</a>}
          {relatedBlips.length > 0 && <a href="#related" class={styles.navTab}>Related</a>}
        </div>
      </nav>
    </div>

    <!-- Details Section -->
    <section id="details" class={styles.detailsSection}>
      <div class={styles.detailsMeta}>
        <div class={styles.detailsDate}>{formattedDate}</div>
        <h2 class={styles.detailsRing} id="ring-status">{blipData.ring}</h2>
        <StatusDropdown 
          blipId={blipData.id} 
          currentRing={blipData.ring} 
          slug={blipData.slug} 
          client:load 
        />
      </div>
      
      <div class={styles.detailsContent}>
        <BlipDescriptionIsland 
          client:only="react"
          initialDescription={blipData.description}
        />
        
        <!-- Authors -->
        {authorResult.length > 0 && (
          <div class={styles.detailsLongText}>
            <strong>Authors:</strong> {authorResult.map((author, index) => (
              <span>
                {author.name}{index < authorResult.length - 1 ? ', ' : ''}
              </span>
            ))}
          </div>
        )}
        
        <!-- Tags -->
        {tagResult.length > 0 && (
          <div class={styles.detailsLongText}>
            <strong>Tags:</strong> {tagResult.map((tag, index) => (
              <span>
                {tag.name}{index < tagResult.length - 1 ? ', ' : ''}
              </span>
            ))}
          </div>
        )}
      </div>
      
      <!-- History Section -->
      {moveResult.length > 0 && (
        <div id="history">
          <h2 class={styles.sectionTitle}>History</h2>
          <div class={styles.historyChart}>
            <BlipHistory 
              moveHistory={moveResult.map(move => [
                move.moveType as "stay" | "grow" | "go",
                new Date(move.moveDate).toISOString()
              ])}
              width={600}
              height={300}
              client:load 
            />
          </div>
        </div>
      )}
    </section>

    <!-- Related Blips Section -->
    {relatedBlips.length > 0 && (
      <section id="related" class={styles.relatedBlipsSection}>
        <h2 class={styles.relatedBlipsTitle}>Related Blips</h2>
        <div class={styles.relatedBlipsGrid}>
          {relatedBlips.map(relatedBlip => (
            <a href={`/blip/neon/${relatedBlip.slug}`} class={styles.relatedBlipCard}>
              <div class={styles.relatedBlipTitleWrapper}>
                <h3 class={styles.relatedBlipTitle}>{relatedBlip.name}</h3>
              </div>
              <span class={styles.relatedBlipMeta}>{relatedBlip.quadrant}</span>
              <span class={styles.relatedBlipMetaUnderlined}>{relatedBlip.ring}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BlipLayout>

<script>
  // Import the store for client-side reactivity
  import { blipColors, applyColorsToElement, setColorsFromQuadrant } from "../../../stores/blip-store";
  
  // Get the container element
  const container = document.getElementById('blip-container');
  if (!container) {
    console.error('Blip container not found');
    throw new Error('Blip container not found');
  }
  
  // Get the current quadrant from the container
  const quadrant = container.getAttribute('data-quadrant') || '';
  
  // Initialize colors from quadrant if available
  if (quadrant) {
    console.log('Setting colors from quadrant:', quadrant);
    setColorsFromQuadrant(quadrant);
  } else {
    console.log('No quadrant data found, cannot set colors');
  }
  
  // Subscribe to color changes and update the container's style
  blipColors.subscribe(colors => {
    // Only update if we have valid colors and container exists
    if (container && colors.quadrantColor && colors.quadrantColorSolid && colors.quadrantColorDark) {
      console.log('Applying colors from store to container');
      applyColorsToElement(container);
    }
  });
</script>

<script>
const navContainer = document.querySelector('.' + CSS.escape('navContainer'));
const sentinel = document.getElementById('nav-sentinel');

if (navContainer && sentinel) {
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (!entry.isIntersecting) {
        navContainer.classList.add('stickyNav');
      } else {
        navContainer.classList.remove('stickyNav');
      }
    },
    { rootMargin: '0px 0px 0px 0px', threshold: 0 }
  );

  observer.observe(sentinel);
}
</script>

