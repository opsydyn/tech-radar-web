---
export const prerender = true;
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BlipListIsland from "~components/BlipListIsland";
import BlipLayout from "~layouts/BlipLayout.astro";
import * as styles from "~styles/pages/quadrant.css";
import type { Blip } from "~types/radar-types";
import { buildRadarEditionViewsFromCollections } from "~utils/editionSnapshotAdapter";
import { getQuadrantColorSolid } from "~utils/quadrantColors";
import {
	getQuadrantPath,
	quadrantRouteLabels,
	type QuadrantRouteKey,
	toQuadrantRouteKey,
} from "~utils/quadrantRouting";

type BlipCollectionEntry = CollectionEntry<"blip"> & { data: Blip };
type EditionSnapshotEntry = CollectionEntry<"editionSnapshot">;
type EditionBlipSnapshotEntry = CollectionEntry<"editionBlipSnapshot">;

export async function getStaticPaths() {
	return Object.keys(quadrantRouteLabels).map((quadrant) => {
		return {
			params: { quadrant: quadrant },
		};
	});
}

const quadrants = quadrantRouteLabels;

const quadrant = (toQuadrantRouteKey(Astro.params.quadrant ?? "tools") ??
	"tools") as QuadrantRouteKey;
const canonicalBlips: BlipCollectionEntry[] = await getCollection("blip");
const editionEntries: EditionSnapshotEntry[] =
	await getCollection("editionSnapshot");
const snapshotEntries: EditionBlipSnapshotEntry[] = await getCollection(
	"editionBlipSnapshot",
);
const editionViews = buildRadarEditionViewsFromCollections({
	canonicalBlips: canonicalBlips.map(({ data }) => data),
	editionEntries,
	snapshotEntries,
});
const latestEditionView = editionViews[0];
const activeEditionId = latestEditionView?.edition.id;
const activeEditionTitle = latestEditionView?.edition.title ?? activeEditionId;
const blipData: Blip[] = latestEditionView
	? latestEditionView.blips.filter(
			(blip) => toQuadrantRouteKey(blip.quadrant) === quadrant,
		)
	: canonicalBlips
			.map(({ data }) => data)
			.filter((data) => toQuadrantRouteKey(data.quadrant) === quadrant);
const quadrantColor = getQuadrantColorSolid(quadrant);

// Helper function to get nav item style classes
const getNavItemClasses = (
	navQuadrant: keyof typeof quadrants,
	currentQuadrant: string,
) => {
	const baseClasses = {
		tools: styles.quadrantNavItemTools,
		techniques: styles.quadrantNavItemTechniques,
		platforms: styles.quadrantNavItemPlatforms,
		"languages-frameworks": styles.quadrantNavItemLanguages,
	} as const;

	const activeClasses = {
		tools: styles.quadrantNavItemActiveTools,
		techniques: styles.quadrantNavItemActiveTechniques,
		platforms: styles.quadrantNavItemActivePlatforms,
		"languages-frameworks": styles.quadrantNavItemActiveLanguages,
	} as const;

	return navQuadrant === currentQuadrant
		? `${baseClasses[navQuadrant]} ${activeClasses[navQuadrant]}`
		: baseClasses[navQuadrant];
};
---

<BlipLayout>
	<div slot="center" class={styles.quadrantContainer}>
		<header class={styles.quadrantHeader}>
			<div class={styles.navigationContainer}>
				<div>
					<h1 class={styles.quadrantTitle}>
						{quadrants[quadrant]}
					</h1>
					{activeEditionTitle && (
						<p
							style={`margin: 0.5rem 0 0; color: ${quadrantColor}; font-family: 'IBM Plex Mono', monospace;`}
						>
							Latest edition snapshot: {activeEditionTitle}
						</p>
					)}
				</div>
				<nav class={styles.quadrantNav}>
					{Object.entries(quadrants).map(([key, label]) => (
						<a
							href={getQuadrantPath(
								key,
								activeEditionId ? { editionId: activeEditionId } : undefined,
							)}
							class={getNavItemClasses(key as keyof typeof quadrants, quadrant)}
						>
							{label}
						</a>
					))}
				</nav>
			</div>
		</header>
		<BlipListIsland
			client:idle
			blips={blipData}
			quadrant={quadrant}
			quadrantColor={quadrantColor}
			editionId={activeEditionId}
		/>
	</div>
</BlipLayout>
