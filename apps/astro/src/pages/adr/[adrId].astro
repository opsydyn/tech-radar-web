---
export const prerender = true;
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BlipLayout from "~layouts/BlipLayout.astro";
import type { AdrData } from "../../content.config";
import { formatDate } from "../../utils/dateFormatter";
import { getTagColor } from "../../utils/tagColors";
import * as styles from "~styles/pages/blip.css";

import DocumentFreshnessIndicator from "../../components/DocumentFreshnessIndicator.astro";
import MetaInfo from "../../components/page/MetaInfo.astro";
// Import shared components
import PageHeader from "../../components/page/PageHeader.astro";
import StickyNavigation from "../../components/page/StickyNavigation.astro";

type RenderableAdrEntry = Parameters<typeof render>[0] & { data: AdrData };

export const getStaticPaths: GetStaticPaths = async () => {
	const adrs = (await getCollection("adr")) as RenderableAdrEntry[];
	return adrs.map(({ data }) => ({
		params: { adrId: data.id },
	}));
};

const adrs = (await getCollection("adr")) as RenderableAdrEntry[];

const { adrId } = Astro.params;
const adr =
	typeof adrId === "string"
		? adrs.find(({ data }) => data.id === adrId)
		: undefined;
const adrData = adr?.data;
const adrContent = adr ? await render(adr) : undefined;
const Content = adrContent?.Content;

// Format the date
const formattedDate = formatDate(adrData?.created);

const primaryTag = adrData?.tags?.[0] || "Frontend";
const tagColorValue = getTagColor(primaryTag);
---

<BlipLayout seo={{ title: adrData?.title ?? "ADR" }}>
  <div slot="center" class={styles.container} style={`
    --quadrant-color: ${tagColorValue};
    --quadrant-color-solid: ${tagColorValue};
    --quadrant-color-dark: ${tagColorValue};
  `}>
    <!-- Hero Section -->
    <PageHeader title={adrData?.title ?? "ADR"} />

    <!-- Navigation Bar -->
    <StickyNavigation
      backLink="/adrs"
      backText="Back to ADRs"
      tabs={[
        { href: "#overview", text: "Overview" },
        { href: "#content", text: "Content" }
      ]}
    />

    <!-- Details Section -->
    <section id="overview" class={styles.detailsSection}>
      <MetaInfo
        date={formattedDate}
        status={adrData?.status || ""}
        cursorColor="#6464ff"
      />

      <!-- Document Freshness Indicator for ADR -->
      <DocumentFreshnessIndicator
        dateString={adrData?.created?.toString() || ""}
        showRecommendation={true}
        size="medium"
      />

      <div class={styles.detailsContent}>
        <div class={styles.detailsDescription}>
          <p><strong>Author:</strong> {adrData?.author}</p>
          <p><strong>Reviewers:</strong> {adrData?.reviewers?.join(", ")}</p>
          <p><strong>Tags:</strong> {adrData?.tags?.join(", ")}</p>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section id="content" class={styles.detailsSection}>
      <h2 class={styles.sectionTitle}>ADR Content</h2>
      <div class={styles.detailsContent}>
        <div class="adr-content">
          {Content && <Content />}
        </div>
      </div>
    </section>
  </div>
</BlipLayout>

<style>
  .sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    background: #111;
    width: 100%;
  }
</style>
