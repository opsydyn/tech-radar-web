---
import GlobalStyles from "~components/GlobalStyles.astro";
import Radar from "~components/radar/Radar";
import MessageDrawer from "~components/MessageDrawer";
import Layout from "~layouts/Layout.astro";
import type { Blip } from "~types/radar-types";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { createEdition } from "~utils/editionHelpers";
import * as styles from "./index.css";
import CornerNav from "@/components/CornerNav.astro";


GlobalStyles;

type BlipCollectionEntry = CollectionEntry<"blip"> & { data: Blip };

const blipCollection: Array<BlipCollectionEntry> = await getCollection("blip");

const blips = blipCollection.map(({ data }: { data: Blip }) => {
  return {
    id: data.id,
    name: data.name,
    quadrant: data.quadrant,
    ring: data.ring,
    description: data.description,
    tags: data.tags,
    hasAdr: data.hasAdr,
    move: data.move,
    created: data.created,
    authors: data.authors,

  };
});

// 🆕 Fetch editions and transform to domain model
const editionCollection = await getCollection("edition");
const editions = editionCollection
  .map(({ data }) => {
    const result = createEdition(data.number, data.title, data.date);
    return result.isOk ? result.value : null;
  })
  .filter((e): e is NonNullable<typeof e> => e !== null)
  .sort((a, b) => b.number - a.number); // Most recent first

---

<Layout>
  <div slot="center" class:list={[styles.flexContainer]}>
    <CornerNav />
    <div class:list={[styles.chartSection]}>
      <Radar blips={blips} editions={editions} client:load />
    </div>
    <MessageDrawer blips={blips} client:only="react" />
  </div>
  <!-- <a slot="center" href="/adrs" class:list={[styles.adrButton]}>ADRs</a> -->
</Layout>
