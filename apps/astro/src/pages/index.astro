---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import GlobalStyles from "~components/GlobalStyles.astro";
import Radar from "~components/radar/Radar";
import { RadarTopNavControls } from "~components/radar/RadarTopNavControls";
import Layout from "~layouts/Layout.astro";
import * as styles from "~styles/pages/index.css";
import type { Blip } from "~types/radar-types";
import { createEdition } from "~utils/editionHelpers";
import { buildRadarEditionViewsFromCollections } from "~utils/editionSnapshotAdapter";

GlobalStyles;

type BlipCollectionEntry = CollectionEntry<"blip"> & { data: Blip };

const blipCollection: BlipCollectionEntry[] = await getCollection("blip");

const blips: Blip[] = blipCollection.map(({ data }: { data: Blip }) => {
	return {
		id: data.id,
		name: data.name,
		quadrant: data.quadrant,
		ring: data.ring,
		description: data.description,
		tags: data.tags,
		hasAdr: data.hasAdr,
		move: data.move,
		created: data.created,
		authors: data.authors,
	};
});

// Legacy editions still support the current move-date model while the
// edition-owned snapshot model is rolled in incrementally.
const editionCollection = await getCollection("edition");
const legacyEditions = editionCollection
	.map(({ data }) => {
		const result = createEdition(data.number, data.title, data.date, data.id);
		return result.isOk ? result.value : null;
	})
	.filter((e): e is NonNullable<typeof e> => e !== null)
	.sort((a, b) => b.number - a.number); // Most recent first

const editionSnapshotCollection = await getCollection("editionSnapshot");
const editionBlipSnapshotCollection = await getCollection(
	"editionBlipSnapshot",
);
const snapshotEditionViews = buildRadarEditionViewsFromCollections({
	canonicalBlips: blips,
	editionEntries: editionSnapshotCollection,
	snapshotEntries: editionBlipSnapshotCollection,
});
const snapshotEditions = snapshotEditionViews
	.map(({ edition }) => {
		const result = createEdition(
			edition.number,
			edition.title,
			edition.date,
			edition.id,
		);
		return result.isOk ? result.value : null;
	})
	.filter((e): e is NonNullable<typeof e> => e !== null);
const hasSnapshotEditions = snapshotEditionViews.length > 0;
const editions = hasSnapshotEditions ? snapshotEditions : legacyEditions;
---

<Layout>
	<RadarTopNavControls slot="topNavControls" client:load />
	<div slot="center" class:list={[styles.flexContainer]}>
		<div class:list={[styles.chartSection]}>
			<Radar
				blips={blips}
				editions={editions}
				editionViews={hasSnapshotEditions ? snapshotEditionViews : undefined}
				client:load
			/>
		</div>
	</div>
</Layout>
