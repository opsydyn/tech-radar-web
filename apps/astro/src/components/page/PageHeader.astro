---
import * as styles from "../../pages/blip/Blip.css";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class={styles.fullBleed}>
  <div class={styles.heroSection}>
    <h1 class={styles.heroTitle}>{title}</h1>
    {subtitle && <p class={styles.heroDate}>{subtitle}</p>}
  </div>
</section>
