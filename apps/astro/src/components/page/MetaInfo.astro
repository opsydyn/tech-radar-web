---
// biome-ignore lint/correctness/noUnusedImports: Astro template markup below uses both imports.
import TypeWriterContainer from "~components/TypeWriterContainer.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template markup below uses these classes.
import * as styles from "~styles/pages/blip.css";

interface Props {
	date: string;
	status?: string;
	cursorColor?: string;
	showDate?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro template markup below consumes these props.
const { date, status, cursorColor = "#6464ff", showDate = true } = Astro.props;
---

<div class={styles.detailsMeta}>
  {showDate && <span class={styles.detailsDate}>{date}</span>}
  {status && (
    <span class={styles.detailsRing}>
      <TypeWriterContainer
        text={status}
        speed={80}
        cursorColor={cursorColor}
        cursorSize="1.5rem"
      />
    </span>
  )}
</div>
