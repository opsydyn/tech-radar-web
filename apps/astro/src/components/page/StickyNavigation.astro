---
// biome-ignore lint/correctness/noUnusedImports: Astro template markup below uses the imported styles.
import * as styles from "~styles/pages/blip.css";
import { withBaseHref } from "~utils/sitePaths";

interface Props {
	backLink: string;
	backText: string;
	tabs: { href: string; text: string; condition?: boolean }[];
	quadrantLinks?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro template markup below consumes these props.
const { backLink, backText, tabs, quadrantLinks = false } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro template markup below uses this resolved href.
const resolvedBackLink = withBaseHref(backLink);
// biome-ignore lint/correctness/noUnusedVariables: Astro template markup below uses these resolved tabs.
const resolvedTabs = tabs.map((tab) => ({
	...tab,
	href: withBaseHref(tab.href),
}));
// biome-ignore lint/correctness/noUnusedVariables: Astro template markup below uses these quadrant links.
const quadrantTabLinks = [
	{ href: withBaseHref("/quadrants/techniques"), label: "Techniques" },
	{ href: withBaseHref("/quadrants/platforms"), label: "Platforms" },
	{ href: withBaseHref("/quadrants/tools"), label: "Tools" },
	{
		href: withBaseHref("/quadrants/languages-frameworks"),
		label: "Languages & Frameworks",
	},
];
---

<div class={styles.navContainer} id="navContainer">
  <nav class={styles.fullBleed} id="mainNav">
    <div class={styles.navBar}>
      <a href={resolvedBackLink} class={styles.navBack}>
        ← {backText}
      </a>
      <div class={styles.navTabs} id="navTabs">
        {resolvedTabs.map(tab => (tab.condition !== false) && (
          <a href={tab.href} class={styles.navTab}>{tab.text}</a>
        ))}
      </div>
    </div>
    
    {quadrantLinks && (
      <>
        {quadrantTabLinks.map((tab) => (
          <a href={tab.href} class={styles.navTab}>{tab.label}</a>
        ))}
      </>
    )}
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const setupSmoothScrolling = () => {
      const HEADER_OFFSET = 70;
      
      const scrollToElement = (element: HTMLElement): void => {
        window.scrollTo({
          top: element.offsetTop - HEADER_OFFSET,
          behavior: 'smooth'
        });
      };
      
      const updateHistory = (targetId: string): void => {
        history.pushState(null, '', targetId);
      };
      
      const handleAnchorClick = (anchor: HTMLAnchorElement) => (e: MouseEvent): void => {
        e.preventDefault();
        
        const targetId = anchor.getAttribute('href');
        if (!targetId) return;
        
        const targetElement = document.querySelector(targetId) as HTMLElement | null;
        if (!targetElement) return;
        
        scrollToElement(targetElement);
        updateHistory(targetId);
      };
      
      const anchors = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
      anchors.forEach(anchor => {
        anchor.addEventListener('click', handleAnchorClick(anchor));
      });
    };
    
    const setupStickyNavigation = () => {
      const navContainer = document.getElementById('navContainer') as HTMLElement | null;
      
      if (!navContainer) return;
      
      const navPosition = navContainer.offsetTop;
      
      const addStickyClass = (): void => {
        navContainer.classList.add('sticky');
        document.body.style.paddingTop = `${navContainer.offsetHeight}px`;
      };
      
      const removeStickyClass = (): void => {
        navContainer.classList.remove('sticky');
        document.body.style.paddingTop = '0';
      };
      
      const handleScroll = (): void => {
        const isScrolledPastNav = window.scrollY >= navPosition;
        isScrolledPastNav ? addStickyClass() : removeStickyClass();
      };
      
      window.addEventListener('scroll', handleScroll);
      handleScroll();
    };
    
    setupSmoothScrolling();
    setupStickyNavigation();
  });
</script>

<style>
  .sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    background: #111;
    width: 100%;
  }

  html[data-theme="light"] .sticky {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  html[data-theme="machine"] .sticky {
    background: #111;
    border-bottom: 1px solid rgba(158, 255, 166, 0.16);
  }
</style>
