---
import * as styles from "~styles/pages/blip.css";
import { getQuadrantPath } from "~utils/quadrantRouting";
import { withBaseHref } from "~utils/sitePaths";

interface Props {
	backLink: string;
	backText: string;
	tabs: { href: string; text: string; condition?: boolean }[];
	quadrantLinks?: boolean;
	quadrantEditionId?: string;
}

const {
	backLink,
	backText,
	tabs,
	quadrantLinks = false,
	quadrantEditionId,
} = Astro.props;
const resolvedBackLink = withBaseHref(backLink);
const resolvedTabs = tabs.map((tab) => ({
	...tab,
	href: withBaseHref(tab.href),
}));
const quadrantTabLinks = [
	{
		href: getQuadrantPath(
			"techniques",
			quadrantEditionId ? { editionId: quadrantEditionId } : undefined,
		),
		label: "Techniques",
	},
	{
		href: getQuadrantPath(
			"platforms",
			quadrantEditionId ? { editionId: quadrantEditionId } : undefined,
		),
		label: "Platforms",
	},
	{
		href: getQuadrantPath(
			"tools",
			quadrantEditionId ? { editionId: quadrantEditionId } : undefined,
		),
		label: "Tools",
	},
	{
		href: getQuadrantPath(
			"languages-frameworks",
			quadrantEditionId ? { editionId: quadrantEditionId } : undefined,
		),
		label: "Languages & Frameworks",
	},
];
---

<div class={styles.navContainer} id="navContainer">
  <nav class={styles.fullBleed} id="mainNav">
    <div class={styles.navBar}>
      <a href={resolvedBackLink} class={styles.navBack}>
        ← {backText}
      </a>
      <div class={styles.navTabs} id="navTabs">
        {resolvedTabs.map(tab => (tab.condition !== false) && (
          <a href={tab.href} class={styles.navTab}>{tab.text}</a>
        ))}
      </div>
    </div>

    {quadrantLinks && (
      <>
        {quadrantTabLinks.map((tab) => (
          <a href={tab.href} class={styles.navTab}>{tab.label}</a>
        ))}
      </>
    )}
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const HEADER_OFFSET = 70;
    const navContainer = document.getElementById('navContainer') as HTMLElement | null;
    const logo = document.getElementById('site-logo') as HTMLElement | null;

    // Smooth scroll for anchor links
    const anchors = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
    anchors.forEach(anchor => {
      anchor.addEventListener('click', (e: MouseEvent) => {
        e.preventDefault();
        const targetId = anchor.getAttribute('href');
        if (!targetId) return;
        const target = document.querySelector(targetId) as HTMLElement | null;
        if (!target) return;
        window.scrollTo({ top: target.offsetTop - HEADER_OFFSET, behavior: 'smooth' });
        history.pushState(null, '', targetId);
      });
    });

    // Sticky nav + logo fade
    if (navContainer) {
      const navNaturalTop = navContainer.offsetTop;

      const update = (): void => {
        const isStuck = window.scrollY >= navNaturalTop;
        navContainer.classList.toggle('sticky', isStuck);
        document.body.style.paddingTop = isStuck ? `${navContainer.offsetHeight}px` : '0';
        if (logo) {
          logo.style.opacity = isStuck ? '0' : '1';
          logo.style.pointerEvents = isStuck ? 'none' : '';
        }
      };

      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  });
</script>

<style>
  .sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    background: #111;
    width: 100%;
  }

  html[data-theme="light"] .sticky {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  html[data-theme="machine"] .sticky {
    background: #111;
    border-bottom: 1px solid rgba(158, 255, 166, 0.16);
  }
</style>
