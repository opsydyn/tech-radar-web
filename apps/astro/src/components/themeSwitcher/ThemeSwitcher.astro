---
// biome-ignore lint/correctness/noUnusedImports: styles are referenced in the Astro template markup below.
import * as styles from "./ThemeSwitcher.css";

// Define client-side script for theme switching
// biome-ignore lint/correctness/noUnusedVariables: the string is injected into the inline Astro script below.
const themeScript = `
  function setTheme(theme) {
    const event = new CustomEvent('theme-change', { detail: { theme } });
    document.dispatchEvent(event);
  }
`;
---

<div class={styles.desktopSwitchers}>
<div class={styles.themeButtons}>
    <button id="theme-dark" aria-label="dark theme switch" class={styles.themeBtn} type="button" onclick="setTheme('dark')">
  <svg xmlns="http://www.w3.org/2000/svg" class={styles.themeIcon}>
    <path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z" />
  </svg>
</button>
    <button id="theme-light" aria-label="light theme switch" class={styles.themeBtn} type="button" onclick="setTheme('light')">
  <svg xmlns="http://www.w3.org/2000/svg" class={styles.themeIcon}>
    <path d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z" />
  </svg>
</button>
    <button id="theme-machine" aria-label="system theme switch" class={styles.themeBtn} type="button" onclick="setTheme('machine')">
  <svg stroke-linejoin="round" viewBox="0 0 18 18" class={styles.themeIcon}>
    <path fill-rule="evenodd" clip-rule="evenodd" d="M1 3.25C1 1.45507 2.45507 0 4.25 0H11.75C13.5449 0 15 1.45507 15 3.25V15.25V16H14.25H1.75H1V15.25V3.25ZM4.25 1.5C3.2835 1.5 2.5 2.2835 2.5 3.25V14.5H13.5V3.25C13.5 2.2835 12.7165 1.5 11.75 1.5H4.25ZM4 4C4 3.44772 4.44772 3 5 3H11C11.5523 3 12 3.44772 12 4V10H4V4ZM9 13H12V11.5H9V13Z"></path>
  </svg>
</button>
</div>

</div>

<!-- Client-side scripts -->
<script>
  // Listen for theme change events and call the imported setTheme function
  import { setTheme } from "~stores/theme-store";
  
  document.addEventListener('theme-change', ((event: Event) => {
    const customEvent = event as CustomEvent<{ theme: import('~stores/theme-store').Theme }>;
    setTheme(customEvent.detail.theme);
  }) as EventListener);
</script>

<script set:html={themeScript}></script>
