---
import * as styles from "./DocumentFreshnessSkeleton.css";

interface Props {
	size?: "small" | "medium" | "large";
}

const { size = "medium" } = Astro.props;
---

<div class={`${styles.container} ${styles.responsiveContainer}`}>
  <div class={`${styles.badge} ${styles.sizeVariants[size]} ${styles.mobileBadge}`}>
    <div class={styles.icon}></div>
    <div class={styles.text}></div>
  </div>
</div>