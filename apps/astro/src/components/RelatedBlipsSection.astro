---
export const prerender = true;

import type { RelatedBlipWithData, RelationshipType } from "../types/radar-types";
import * as styles from "~styles/pages/blip.css";
import { hardEdgeRadius } from "~styles/theme.css";
import RelationshipTypesTooltip from "./RelationshipTypesTooltip.tsx";
import { getBlipPath } from "../utils/blipRouting";

// Fluent UI Icons - using simple SVG paths instead of React components
const relationshipIcons = {
    alternative: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z",
    complement: "M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H6.5C4.01 7 2 9.01 2 11.5S4.01 16 6.5 16H11v-1.9H6.5c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9.5-6H13v1.9h4.5c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1H13V16h4.5c2.49 0 4.5-2.01 4.5-4.5S19.99 7 17.5 7z",
    migration: "M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z",
    prerequisite: "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z",
    evolution: "M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z",
    comparison: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z",
    ecosystem: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.91-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"
} as const;

const relationshipLabels: Record<RelationshipType, string> = {
    alternative: "Alternative",
    complement: "Complement",
    migration: "Migration Path",
    prerequisite: "Prerequisite",
    evolution: "Evolution",
    comparison: "Comparison",
    ecosystem: "Ecosystem",
} as const;

const relationshipColors: Record<RelationshipType, string> = {
    alternative: "#4ade80", // Light green
    complement: "#60a5fa",  // Light blue
    migration: "#f87171",   // Light red
    prerequisite: "#c084fc", // Light purple
    evolution: "#fbbf24",   // Light amber
    comparison: "#fb7185",  // Light pink
    ecosystem: "#34d399",   // Light emerald
} as const;

interface Props {
    relatedBlips: RelatedBlipWithData[];
    currentBlipName: string;
}

const { relatedBlips, currentBlipName } = Astro.props;

// Simple grouping function (no need for useMemo)
const groupBlipsByRelationship = (blips: RelatedBlipWithData[]) =>
    blips.reduce((acc, blip) => {
        const type = blip.relationshipType;
        if (!acc[type]) {
            acc[type] = [];
        }
        acc[type].push(blip);
        return acc;
    }, {} as Record<RelationshipType, RelatedBlipWithData[]>);

const groupedBlips = groupBlipsByRelationship(relatedBlips);
const relationshipTypes = Object.keys(groupedBlips) as RelationshipType[];
    ---

{relatedBlips.length === 0 ? (
    <div class={styles.relatedBlipsEmptyState}>
        No related technologies defined yet.
    </div>
) : (
    <section style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1rem;">
            <h2 class={styles.relatedBlipsTitle} style="margin: 0;">
                Related Technologies
            </h2>
            <RelationshipTypesTooltip client:only="react" />
        </div>
        <p class={styles.relatedBlipsIntro}>
            Technologies related to <strong class={styles.relatedBlipsIntroStrong}>{currentBlipName}</strong> and their relationships.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; align-items: start;">
            {relationshipTypes.map((type) => {
                const blips = groupedBlips[type];
                const color = relationshipColors[type];
                const iconPath = relationshipIcons[type];

                return (
                    <div style="margin-bottom: 3rem; break-inside: avoid; page-break-inside: avoid;">
                        <div style={`display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid ${color}; color: ${color};`}>
                            <svg style={`width: 1.25rem; height: 1.25rem; fill: ${color};`} viewBox="0 0 24 24">
                                <path d={iconPath}></path>
                            </svg>
                            <h3 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 1.125rem; font-weight: 600;">
                                {relationshipLabels[type]}
                            </h3>
                            <span style={`background-color: ${color}; color: #000; padding: 0.25rem 0.75rem; border-radius: ${hardEdgeRadius}; font-size: 0.75rem; font-weight: 600; font-family: 'IBM Plex Mono', monospace;`}>
                                {blips.length}
                            </span>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; align-items: start;">
                            {blips.map((blip) => (
                                <a
                                    href={getBlipPath({ id: blip.blipId, name: blip.blipName })}
                                    class={styles.relatedBlipCard}
                                    title={`View ${blip.blipName} details`}
                                    style="margin: 0; min-height: fit-content; height: auto;"
                                >
                                    <span class={styles.relatedBlipMeta}>{blip.blipRing}</span>
                                    <div class={styles.relatedBlipTitleWrapper}>
                                        <h3 class={styles.relatedBlipTitle}>{blip.blipName}</h3>
                                    </div>
                                    <p class={styles.relatedBlipMetaUnderlined}>
                                        {blip.blipQuadrant.replace("languages-frameworks", "Languages & Frameworks")}
                                    </p>

                                    {(blip.reason || blip.context) && (
                                        <div class={styles.relatedBlipContext}>
                                            {blip.reason && (
                                                <div class={styles.relatedBlipContextItem}>
                                                    <strong>Why:</strong> {blip.reason}
                                                </div>
                                            )}
                                            {blip.context && (
                                                <div class={styles.relatedBlipContextItem}>
                                                    <strong>Context:</strong> {blip.context}
                                                </div>
                                            )}
                                        </div>
                                    )}
                                </a>
                            ))}
                        </div>
                    </div>
                );
            })}
        </div>
    </section>
)}