---
import { Cancel } from "pixelarticons/react/Cancel";
import { ChevronRight2 } from "pixelarticons/react/ChevronRight2";
import type { Edition } from "~utils/editionHelpers";
import * as styles from "./RadarSidebar.css";
import { RadarSidebarController } from "./RadarSidebarController";
import { RadarSidebarControls } from "./RadarSidebarControls";
import { RadarSidebarQuadrantLinks } from "./RadarSidebarQuadrantLinks";
import { RadarSidebarRadarToggle } from "./RadarSidebarRadarToggle";

type Props = {
	editions: Edition[];
};

const { editions } = Astro.props;
---

<button
	type="button"
	class={styles.collapsedTrigger}
	data-open="true"
	data-radar-sidebar-open-state
	data-radar-sidebar-trigger
	aria-label="Open radar controls"
>
	<ChevronRight2 className={styles.collapsedTriggerIcon} aria-hidden="true" />
</button>

<div class={styles.swipeArea} data-radar-sidebar-swipe-area></div>
<div class={styles.viewport} data-open="true" data-radar-sidebar-open-state>
	<aside
		class={styles.popup}
		data-open="true"
		data-radar-sidebar-open-state
		role="complementary"
		aria-label="Radar controls"
	>
		<div class={styles.surface}>
			<h2 class={styles.visuallyHidden}>Radar controls</h2>
			<button
				type="button"
				class={styles.closeButton}
				aria-label="Collapse radar controls"
				data-base-ui-swipe-ignore=""
				data-radar-sidebar-close
			>
				<Cancel className={styles.closeIcon} aria-hidden="true" />
			</button>
			<div class={styles.content}>
				<section class={styles.section} data-base-ui-swipe-ignore="">
					<div class={styles.sectionHeading}>Edition</div>
					<RadarSidebarControls editions={editions} client:load />
				</section>

				<section class={styles.section}>
					<div class={styles.sectionHeading}>Quadrants</div>
					<RadarSidebarQuadrantLinks client:load />
				</section>

				<section class={styles.radarSection} data-base-ui-swipe-ignore="">
					<div class={styles.sectionHeading}>Radar</div>
					<RadarSidebarRadarToggle client:load />
				</section>
			</div>
		</div>
	</aside>
</div>

<RadarSidebarController client:load />

<script is:inline>
	(() => {
		const isOpen = window.localStorage.getItem("tech-radar.sidebar-open") !== "false";
		const openState = String(isOpen);
		const applyOpenState = () => {
			document
				.querySelectorAll(
					"[data-radar-sidebar-open-state], [data-radar-sidebar-spacer]",
				)
				.forEach((element) => {
					element.setAttribute("data-open", openState);
				});
		};

		applyOpenState();

		const observer = new MutationObserver(() => {
			applyOpenState();

			if (document.querySelector("[data-radar-sidebar-spacer]")) {
				observer.disconnect();
			}
		});

		observer.observe(document.documentElement, {
			childList: true,
			subtree: true,
		});

		window.setTimeout(() => observer.disconnect(), 1000);
	})();
</script>
