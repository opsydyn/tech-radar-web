---
import { Match } from "effect";
import AgingIcon from "~assets/svg/freshness-aging.svg";
import CriticalIcon from "~assets/svg/freshness-critical.svg";
import FreshIcon from "~assets/svg/freshness-fresh.svg";
import InvalidIcon from "~assets/svg/freshness-invalid.svg";
import StaleIcon from "~assets/svg/freshness-stale.svg";
import type { DateValue } from "../utils/dateFormatter";
// biome-ignore format: keep this import on one line to avoid Astro frontmatter formatting churn.
import { calculateDocumentFreshness, type DocumentFreshnessLevel } from "../utils/documentFreshness";
// biome-ignore lint/correctness/noUnusedImports: styles are referenced in the Astro template markup below.
import * as styles from "./DocumentFreshnessIndicator.css";

type Props = {
	dateValue: DateValue;
	showRecommendation?: boolean;
	size?: "small" | "medium" | "large";
};

// biome-ignore lint/correctness/noUnusedVariables: values are consumed in the Astro template below.
const { dateValue, showRecommendation = true, size = "medium" } = Astro.props;

// Calculate freshness on the server
const freshness = calculateDocumentFreshness(dateValue);

// Map freshness level to imported SVG component
const ICON_COMPONENTS: Record<DocumentFreshnessLevel, typeof FreshIcon> = {
	fresh: FreshIcon,
	aging: AgingIcon,
	stale: StaleIcon,
	critical: CriticalIcon,
	invalid: InvalidIcon,
};

// biome-ignore lint/correctness/noUnusedVariables: value is rendered in the Astro template below.
const IconComponent = ICON_COMPONENTS[freshness.level];

// biome-ignore lint/correctness/noUnusedVariables: value is consumed by the Astro conditional rendering below.
const shouldShowRecommendation = Match.value({
	showRecommendation,
	actionable: freshness.actionable,
}).pipe(
	Match.when({ showRecommendation: true, actionable: true }, () => true),
	Match.orElse(() => false),
);
---

<div class={`${styles.container} ${styles.responsiveContainer}`}>
  <!-- Freshness Badge -->
  <div class={`${styles.badgeVariants[freshness.level]} ${styles.sizeVariants[size]}`}>
    <div class={styles.iconContainer}>
      <IconComponent width="16" height="16" />
    </div>
    <span class={styles.textContainer}>{freshness.message}</span>
  </div>

  <!-- Recommendation -->
  {shouldShowRecommendation && (
    <div class={styles.recommendation}>
      <div class={styles.recommendationIcon}>
        <CriticalIcon width="16" height="16" />
      </div>
      <span>{freshness.recommendation}</span>
    </div>
  )}
</div>
