---
import type { CollectionEntry } from "astro:content";

import Link from "./Link.astro";

export type Props = {
  adrs: Array<CollectionEntry<"adr">>;
  start?: number;
};

const { adrs, start = 1 } = Astro.props;
---

<ol class="mt-4 px-10 space-y-2 list-decimal" start={start}>
  {
    adrs.map((adr) => (
      <li>
        <Link class="flex justify-between" href={`/adr/${adr.slug}`}>
          {adr.slug}
          <span class="text-gray-400"> adr timestamp </span>
        </Link>
      </li>
    ))
  }
</ol>
