{
  "name": "tech-radar-v2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "tooling/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "moon": "moon",
    "moon:check": "moon check",
    "moon:run": "moon run",
    "moon:ci": "moon ci",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:dependencies": "knip --dependencies",
    "preview": "moon run astro:preview",
    "prettier": "bunx prettier --write . --plugin=prettier-plugin-astro",
    "astro": "moon run astro:astro",
    "test": "vitest --run",
    "test:watch": "vitest",
    "commit": "cz",
    "sherif": "bunx sherif@latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@effect/language-service": "0.85.1",
    "@moonrepo/cli": "^2.2.3",
    "commitizen": "^4.3.0",
    "cz-emoji-conventional": "^1.0.2",
    "knip": "^6.11.0",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": "22.12.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-emoji-conventional"
    }
  },
  "release": {
    "analyzeCommits": "semantic-release-conventional-commits",
    "path": "semantic-release-conventional-commits",
    "majorTypes": [
      "major",
      "breaking"
    ],
    "minorTypes": [
      "feat",
      "minor"
    ],
    "patchTypes": [
      "fix",
      "patch"
    ],
    "packageManager": "bun@1.3.11",
    "mergePattern": "/^Merge pull request #(\\d+) from (.*)$/",
    "mergeCorrespondence": "['id', 'source']"
  },
  "dependencies": {}
}
